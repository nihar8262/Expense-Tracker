# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker
# Optional: Set to "false" to disable runtime DDL checks on request
# RUN_SCHEMA_SETUP_ON_REQUEST=true

# ==============================================================================
# Backend Server & CRON Configuration
# ==============================================================================
PORT=4101
# Secret token required for triggering /api/internal/run-reminder-checks (CRON)
SCHEDULER_SECRET=

# ==============================================================================
# AI & Machine Learning Services
# ==============================================================================
# Google Gemini API Key (used for receipt OCR extraction and pgvector embeddings)
GEMINI_API_KEY=

# In-App Assistant LLM Configuration
LLM_API_KEY=
# Optional: Model name (defaults to "meta/llama-3.2-11b-vision-instruct")
LLM_MODEL=meta/llama-3.2-11b-vision-instruct

# ==============================================================================
# Email & Notifications (Resend)
# ==============================================================================
# Resend API key for delivering user feedback notifications
RESEND_API_KEY=
# Recipient email address for admin feedback notifications
EMAIL=

# ==============================================================================
# MCP (Model Context Protocol) CLI / Stdio Mode (Optional)
# ==============================================================================
# Pre-authenticated user ID or token for local stdio MCP sessions
EXPENSE_USER_ID=
EXPENSE_MCP_TOKEN=

# ==============================================================================
# Firebase Admin SDK (Server / API)
# ==============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Keep newline escapes intact ("-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n")
FIREBASE_PRIVATE_KEY=

# ==============================================================================
# Frontend Environment Variables (Vite)
# ==============================================================================
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=